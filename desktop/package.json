{
  "name": "floating-pet-preview",
  "version": "0.1.0",
  "private": true,
  "description": "Floating Pet MiniCPM-o Ascend Preview",
  "main": "src/main.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/check.mjs",
    "start": "npm run build && electron .",
    "start:fake": "npm run build && electron . --fake-model",
    "test:unit": "node --test tests/core.test.cjs tests/model-client.test.cjs tests/realtime-client.test.cjs tests/realtime-playback.test.cjs",
    "test:e2e": "npm run build && node tests/e2e.cjs",
    "test:service": "cd .. && python -m unittest discover -s service/tests -v",
    "test:integration": "node --test tests/realtime-service.integration.test.cjs",
    "test:real": "npm run build && node tests/real-model.e2e.cjs",
    "test:real:screen": "node tests/real-screen-cue.e2e.cjs",
    "test:real:duplex": "node tests/real-duplex.e2e.cjs",
    "test:real:duplex:continuous": "node tests/real-duplex-continuous.e2e.cjs",
    "test:real:duplex:soak": "node tests/real-duplex-soak.e2e.cjs",
    "package": "npm run check && npm run build && electron-builder --win nsis portable zip",
    "verify:package": "node scripts/verify-package.mjs release"
  },
  "devDependencies": {
    "@electron/asar": "4.2.0",
    "electron": "43.1.1",
    "electron-builder": "26.15.3",
    "playwright-core": "1.61.1"
  }
}
